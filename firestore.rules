rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── SINGLE ADMIN ──
    // Testing mode (now): isAdmin() = any signed-in user, so you can sign up,
    // seed data and use the admin dashboard end-to-end.
    // Lockdown (after you send your UID): replace the body with
    //   return request.auth != null && request.auth.uid == "YOUR_UID_HERE";
    // and redeploy. Client-side admin.html already gates via ADMIN_UID.
    function isAdmin() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }
    match /events/{id} { allow read: if true; allow write: if isAdmin(); }
    match /gameRooms/{id} { allow read, write: if request.auth != null; }
    match /suggestions/{id} { allow read: if true; allow write: if request.auth != null; }
    match /chats/{chatId} {
      allow read, create, update: if request.auth != null;
      match /messages/{msgId} { allow read, write: if request.auth != null; }
    }
    match /contributors/{id} { allow read: if true; allow write: if isAdmin(); }
    match /themes/{id} { allow read: if true; allow write: if isAdmin(); }
    match /pending/{id} { allow read, write: if request.auth != null; }
    match /uploads/{id} { allow read, write: if request.auth != null; }
    match /challenges/{id} { allow read: if true; allow write: if request.auth != null; }
    match /challengeAttempts/{id} { allow read, write: if request.auth != null; }
    match /throneAttempts/{id} { allow read, write: if request.auth != null; }
    match /notifications/{id} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null;
    }
  }
}
