rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── SINGLE ADMIN ──
    // Locked to the community admin's UID below. Only that account can
    // post events / contributors / themes, update other users, or delete.
    // To rotate admin: replace the UID here AND in firebase-config.js,
    // then redeploy rules + hosting together.
    function isAdmin() {
      return request.auth != null && request.auth.uid == "2K4mB8Fw3oZJMSwB2PiozJy8Ycp2";
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }
    match /events/{id} { allow read: if true; allow write: if isAdmin(); }
    match /gameRooms/{id} { allow read, write: if request.auth != null; }
    match /suggestions/{id} { allow read: if true; allow write: if request.auth != null; }
    match /chats/{chatId} {
      allow read, create, update: if request.auth != null;
      match /messages/{msgId} { allow read, write: if request.auth != null; }
    }
    match /contributors/{id} { allow read: if true; allow write: if isAdmin(); }
    match /themes/{id} { allow read: if true; allow write: if isAdmin(); }
    match /pending/{id} { allow read, write: if request.auth != null; }
    match /reports/{id} { allow read: if isAdmin(); allow create: if request.auth != null; allow update, delete: if isAdmin(); }
    match /uploads/{id} { allow read, write: if request.auth != null; }
    match /challenges/{id} { allow read: if true; allow write: if request.auth != null; }
    match /challengeAttempts/{id} { allow read, write: if request.auth != null; }
    match /throneAttempts/{id} { allow read, write: if request.auth != null; }
    match /notifications/{id} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null;
    }
  }
}
